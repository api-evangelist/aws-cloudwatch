  "info": {
    "_postman_id": "7ee24e73-c624-4567-9aac-99600c183aa0",
    "name": "Amazon CloudWatch Amazon CloudWatch API API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Amazon CloudWatch is a monitoring and observability service that collects\nmetrics, logs, and events from AWS resources and applications. The\nCloudWatch Query API accepts POST requests to the root path with the\nAction and Version specified as form parameters in the\napplication/x-www-form-urlencoded request body. All requests are signed\nwith AWS Signature Version 4 (SigV4).\n\nSee https://docs.aws.amazon.com/AmazonCloudWatch/latest/APIReference/Welcome.html\n",
      "type": "text/plain"
    }
  }
